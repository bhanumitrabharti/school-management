rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Auth helpers ─────────────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    // F8: Super-admin Firebase Auth UID.
    // ACTION REQUIRED (Antigravity): Replace cq647u1GfCXISzf7XMw8pxH76I72
    // with the real UID after creating superadmin@ctrlshifts.in in Firebase Auth.
    function isSuperAdmin() {
      return isAuthenticated() &&
             request.auth.uid == 'cq647u1GfCXISzf7XMw8pxH76I72';
    }

    // F1: Tenant isolation — user must have written their school_access/{uid}
    // document (done by app.js on login) with a schoolId matching the target.
    // A user can only write their OWN school_access document (uid == auth.uid),
    // so they cannot forge another user's mapping.
    function canAccessSchool(schoolId) {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/school_access/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/school_access/$(request.auth.uid)).data.schoolId == schoolId;
    }

    function canReadTenant(schoolId) {
      return !isAuthenticated() ||
             !exists(/databases/$(database)/documents/school_access/$(request.auth.uid)) ||
             get(/databases/$(database)/documents/school_access/$(request.auth.uid)).data.schoolId == schoolId;
    }

    // HARD GUARD for students and teachers:
    // Even if restructured is true, students and teachers must NEVER be wiped to []
    // unless an explicit server-level override flag allowCollectionWipe == true is present.
    // SECURITY: allowCollectionWipe client bypass removed. Wipe operations
    // must go through the Firebase Admin SDK (server.js) which bypasses rules.
    function notWipingRoster(fieldName) {
      return (resource == null || resource.data == null) ||
             !(resource.data.get(fieldName, []).size() > 0 && request.resource.data.get(fieldName, []).size() == 0);
    }

    // Guard for fees and attendance:
    // Allowed to become empty ONLY IF restructured == true (migrated to subcollections)
    // or explicit override flag is present.
    function notWipingLedger(fieldName) {
      return (request.resource.data.settings != null && request.resource.data.settings.restructured == true) ||
             (resource == null || resource.data == null) ||
             !(resource.data.get(fieldName, []).size() > 0 && request.resource.data.get(fieldName, []).size() == 0);
    }

    // SEC-11: Prevent oversized signature / logo blobs being written into the
    // main tenant document.  The client already enforces a 500 KB upload cap;
    // this Firestore-level guard is a defence-in-depth backstop.
    // base64(500 KB) ≈ 680 000 chars; 800 000 chars gives a comfortable margin
    // while still rejecting anything far outside the intended size range.
    // Only checked when a 'settings' key is present in the incoming write.
    function notOversizedBlobs() {
      let s = request.resource.data.get('settings', null);
      return s == null
        || (s.get('principalSignatureUrl', '').size() < 800000
            && s.get('logoUrl', '').size() < 800000);
    }

    // ── F1: school_access — each user owns and manages only their own entry ──
    match /school_access/{uid} {
      allow read:  if isAuthenticated() && request.auth.uid == uid;
      allow write: if isAuthenticated() && request.auth.uid == uid;
    }

    // SEC-10: Validate fee month document structure on write.
    // Firestore Rules cannot iterate array elements, so per-transaction
    // amount checks live in app.js (_validateFeeTransaction).  This rule
    // ensures the document shape is exactly what the app writes, preventing
    // an attacker from injecting arbitrary fields or a non-list payload.
    function validFeeMonthDoc() {
      return request.resource.data.keys().hasOnly(['transactions'])
          && request.resource.data.transactions is list
          && request.resource.data.transactions.size() <= 1000;
    }

    // ── Tenant school data — F1: restricted to mapped school per user ─────────
    match /tenant_data/{schoolId} {
      allow read:   if canReadTenant(schoolId);
      allow create: if canAccessSchool(schoolId) &&
                       notWipingRoster('students') &&
                       notWipingRoster('teachers') &&
                       notOversizedBlobs();           // SEC-11
      allow update: if canAccessSchool(schoolId) &&
                       notWipingRoster('students') &&
                       notWipingRoster('teachers') &&
                       notWipingLedger('fees') &&
                       notWipingLedger('attendance') &&
                       notWipingLedger('examMarks') &&
                       notOversizedBlobs();           // SEC-11
      allow delete: if false;
    }

    // Subcollections — per-school access.
    // For fees_years specifically, writes must also satisfy validFeeMonthDoc():
    // this prevents injecting arbitrary keys or non-list transaction payloads.   SEC-10
    match /tenant_data/{schoolId}/{subcollection}/{allChildren=**} {
      allow read:  if canAccessSchool(schoolId);
      allow write: if canAccessSchool(schoolId)
          && (subcollection != 'fees_years' || validFeeMonthDoc());  // SEC-10
    }

    // ── School registry — public read; write = super-admin only ──────────────
    // super-admin.js must call signInWithEmailAndPassword(auth, 'superadmin@ctrlshifts.in', ...)
    // before any write so that request.auth.uid satisfies isSuperAdmin().
    match /schools/{schoolId} {
      allow read:  if true;
      allow write: if isSuperAdmin();
    }

    // ── F8: Super-admin data — restricted to super-admin Firebase UID only ───
    match /sa_data/{docId} {
      allow read, write: if isSuperAdmin();
    }

    // ── Demo requests — unauthenticated create (landing page contact form) ───
    match /demo_requests/{docId} {
      allow create:              if true;
      allow read, update, delete: if isAuthenticated();
    }

  }
}
