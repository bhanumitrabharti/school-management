rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function notWiping(fieldName) {
      return (request.resource.data.settings != null && request.resource.data.settings.restructured == true) ||
             !(resource.data.get(fieldName, []).size() > 0 && request.resource.data.get(fieldName, []).size() == 0);
    }

    match /tenant_data/{schoolId} {
      allow read: if true;
      allow create: if true;
      allow update: if notWiping('students') && notWiping('fees') && notWiping('attendance') && notWiping('teachers');
      allow delete: if false;
    }

    match /tenant_data/{schoolId}/{allChildren=**} {
      allow read, write: if true;
    }

    match /schools/{schoolId} {
      allow read, write: if true;
    }

    match /sa_data/{docId} {
      allow read, write: if true;
    }

    match /demo_requests/{docId} {
      allow read, write: if true;
    }

  }
}
