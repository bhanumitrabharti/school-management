rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Auth helpers ─────────────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    // F8: Super-admin Firebase Auth UID
    function isSuperAdmin() {
      return isAuthenticated() &&
             request.auth.uid == 'cq647u1GfCXISzf7XMw8pxH76I72';
    }

    // F1: Tenant isolation — verified mapping created by server API
    function isSchoolAdmin(schoolId) {
      return canAccessSchool(schoolId) &&
             get(/databases/$(database)/documents/school_access/$(request.auth.uid)).data.get('role', '') == 'admin';
    }

    function canAccessSchool(schoolId) {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/school_access/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/school_access/$(request.auth.uid)).data.schoolId == schoolId;
    }

    // HARD GUARD for students and teachers
    function notWipingRoster(fieldName) {
      return (resource == null || resource.data == null) ||
             !(resource.data.get(fieldName, []).size() > 0 && request.resource.data.get(fieldName, []).size() == 0);
    }

    // Guard for fees and attendance
    function notWipingLedger(fieldName) {
      return (request.resource.data.settings != null && request.resource.data.settings.restructured == true) ||
             (resource == null || resource.data == null) ||
             !(resource.data.get(fieldName, []).size() > 0 && request.resource.data.get(fieldName, []).size() == 0);
    }

    // SEC-11: Prevent oversized signature / logo blobs
    function notOversizedBlobs() {
      let s = request.resource.data.get('settings', null);
      return s == null
        || (s.get('principalSignatureUrl', '').size() < 800000
            && s.get('logoUrl', '').size() < 800000);
    }

    // SEC-10: Validate fee month document structure on write
    function validFeeMonthDoc() {
      return request.resource.data.keys().hasOnly(['transactions'])
          && request.resource.data.transactions is list
          && request.resource.data.transactions.size() <= 1000;
    }

    // ── F1: school_access — client writes permanently blocked (server API only) ──
    match /school_access/{uid} {
      allow read:  if isAuthenticated() && request.auth.uid == uid;
      allow write: if false;
    }

    // ── Tenant school data — restricted to mapped school or super-admin ─────────
    match /tenant_data/{schoolId} {
      allow read:   if canAccessSchool(schoolId) || isSuperAdmin();
      allow create: if (canAccessSchool(schoolId) || isSuperAdmin()) &&
                       notWipingRoster('students') &&
                       notWipingRoster('teachers') &&
                       notOversizedBlobs();
      allow update: if (canAccessSchool(schoolId) || isSuperAdmin()) &&
                       notWipingRoster('students') &&
                       notWipingRoster('teachers') &&
                       notWipingLedger('fees') &&
                       notWipingLedger('attendance') &&
                       notWipingLedger('examMarks') &&
                       notOversizedBlobs();
      allow delete: if false;
    }

    // ── Student & Teacher Profiles Subcollections (Custom Fields & Privacy Isolation) ──
    // Private student profiles — school admin + super admin only
    match /tenant_data/{schoolId}/student_profiles/{studentId} {
      allow read, write: if isSchoolAdmin(schoolId) || isSuperAdmin();
    }

    // Shared student profiles (visible to teachers) — readable by school users (admin/teacher) of that school, writable only by school admin / super admin
    match /tenant_data/{schoolId}/student_profiles_shared/{studentId} {
      allow read:  if canAccessSchool(schoolId) || isSuperAdmin();
      allow write: if isSchoolAdmin(schoolId) || isSuperAdmin();
    }

    // Helper to check if caller is this specific teacher
    function isOwnTeacherProfile(schoolId, teacherId) {
      return canAccessSchool(schoolId) &&
             exists(/databases/$(database)/documents/school_access/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/school_access/$(request.auth.uid)).data.get('teacherId', '') == teacherId;
    }

    // Teacher profiles — school admin + super admin: read/write; own teacher: read-only; other teachers: denied; write: admin/super admin only
    match /tenant_data/{schoolId}/teacher_profiles/{teacherId} {
      allow read:  if isSchoolAdmin(schoolId) || isSuperAdmin() || isOwnTeacherProfile(schoolId, teacherId);
      allow write: if isSchoolAdmin(schoolId) || isSuperAdmin();
    }

    // Helper to check if caller is an authorized teacher of this school
    function isSchoolTeacher(schoolId) {
      return canAccessSchool(schoolId) &&
             exists(/databases/$(database)/documents/school_access/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/school_access/$(request.auth.uid)).data.get('role', '') == 'teacher';
    }

    // Core Students Subcollection — school admin & super admin: read/write; school teachers: read-only; other teachers/schools: denied
    match /tenant_data/{schoolId}/students/{studentId} {
      allow read:  if isSchoolAdmin(schoolId) || isSuperAdmin() || isSchoolTeacher(schoolId);
      allow write: if (isSchoolAdmin(schoolId) || isSuperAdmin())
                      && request.resource.data.schoolId == schoolId;
    }

    // Subcollections — per-school access or super-admin (excluding student/teacher profiles and core students)
    match /tenant_data/{schoolId}/{subcollection}/{allChildren=**} {
      allow read:  if subcollection != 'student_profiles'
                      && subcollection != 'student_profiles_shared'
                      && subcollection != 'teacher_profiles'
                      && subcollection != 'students'
                      && (canAccessSchool(schoolId) || isSuperAdmin());
      allow write: if subcollection != 'student_profiles'
                      && subcollection != 'student_profiles_shared'
                      && subcollection != 'teacher_profiles'
                      && subcollection != 'students'
                      && (canAccessSchool(schoolId) || isSuperAdmin())
                      && (subcollection != 'fees_years' || validFeeMonthDoc());
    }

    // ── School registry — public read; write = super-admin or school admin branding sync ──
    match /schools/{schoolId} {
      allow read:   if true;
      allow create: if isSuperAdmin();
      allow delete: if isSuperAdmin();
      allow update: if isSuperAdmin() ||
                       (isSchoolAdmin(schoolId) &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['logo_url', 'school_name', 'tagline']) &&
                        request.resource.data.get('logo_url', '').size() < 800000);
    }

    // ── F8: Super-admin data — restricted to super-admin Firebase UID only ───
    match /sa_data/{docId} {
      allow read, write: if isSuperAdmin();
    }

    // ── Demo requests — public create with basic validation; super-admin management ──
    match /demo_requests/{docId} {
      allow create:              if request.resource.data.get('phone', '') is string
                                    && request.resource.data.get('phone', '').size() >= 10;
      allow read, update, delete: if isSuperAdmin();
    }

    // ── Login rate limits — Admin SDK only ──────────────────────────────────
    match /login_rate_limits/{docId} {
      allow read, write: if false;
    }

    // ── Class rename backups — super-admin only ─────────────────────────────
    match /rename_backups/{docId} {
      allow read, write: if isSuperAdmin();
    }

  }
}
