rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Auth helpers ─────────────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    // F8: Super-admin Firebase Auth UID
    function isSuperAdmin() {
      return isAuthenticated() &&
             request.auth.uid == 'cq647u1GfCXISzf7XMw8pxH76I72';
    }

    // F1: Tenant isolation — verified mapping created by server API
    function isSchoolAdmin(schoolId) {
      return canAccessSchool(schoolId) &&
             get(/databases/$(database)/documents/school_access/$(request.auth.uid)).data.get('role', '') == 'admin';
    }

    // Helper to check if caller is an authorized teacher of this school
    function isSchoolTeacher(schoolId) {
      return canAccessSchool(schoolId) &&
             exists(/databases/$(database)/documents/school_access/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/school_access/$(request.auth.uid)).data.get('role', '') == 'teacher';
    }

    // Helper to get caller's teacherId from school_access
    function getTeacherId(schoolId) {
      return get(/databases/$(database)/documents/school_access/$(request.auth.uid)).data.get('teacherId', '');
    }

    // Helper to check if caller is this specific teacher
    function isOwnTeacherProfile(schoolId, teacherId) {
      return canAccessSchool(schoolId) &&
             exists(/databases/$(database)/documents/school_access/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/school_access/$(request.auth.uid)).data.get('teacherId', '') == teacherId;
    }

    function canAccessSchool(schoolId) {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/school_access/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/school_access/$(request.auth.uid)).data.schoolId == schoolId;
    }

    // HARD GUARD for students and teachers
    function notWipingRoster(fieldName) {
      return (resource == null || resource.data == null) ||
             !(resource.data.get(fieldName, []).size() > 0 && request.resource.data.get(fieldName, []).size() == 0);
    }

    // Guard for fees and attendance
    function notWipingLedger(fieldName) {
      return (request.resource.data.settings != null && request.resource.data.settings.restructured == true) ||
             (resource == null || resource.data == null) ||
             !(resource.data.get(fieldName, []).size() > 0 && request.resource.data.get(fieldName, []).size() == 0);
    }

    // SEC-11: Prevent oversized signature / logo blobs
    function notOversizedBlobs() {
      let s = request.resource.data.get('settings', null);
      return s == null
        || (s.get('principalSignatureUrl', '').size() < 800000
            && s.get('logoUrl', '').size() < 800000);
    }

    // SEC-10: Validate fee month document structure on write
    function validFeeMonthDoc() {
      return request.resource.data.keys().hasOnly(['transactions'])
          && request.resource.data.transactions is list
          && request.resource.data.transactions.size() <= 1000;
    }

    // Rule for teacher-allowed targeted root document updates (v1 legacy only)
    function isTeacherAllowedRootUpdate(schoolId) {
      return isSchoolTeacher(schoolId) &&
             (resource.data.get('settings', {}).get('storageVersion', 1) < 2) &&
             request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'teacherAttendance',
               'attendanceRequests',
               'teacherCorrectionRequests',
               'absenceIntimationLog'
             ]);
    }

    // Anti-resurrection guard: prevent migrated keys from being reintroduced or modified on root doc once storageVersion >= 2
    function noMigratedKeysResurrection() {
      return (resource.data.get('settings', {}).get('storageVersion', 1) < 2) ||
             !request.resource.data.diff(resource.data).affectedKeys().hasAny([
               'teacherAttendance',
               'attendanceRequests',
               'teacherCorrectionRequests',
               'absenceIntimationLog',
               'notices',
               'notifications',
               'examAuditLog',
               'examMarksAuditLog',
               'trash',
               'feeActivityLog'
             ]);
    }

    // ── F1: school_access — client writes permanently blocked (server API only) ──
    match /school_access/{uid} {
      allow read:  if isAuthenticated() && request.auth.uid == uid;
      allow write: if false;
    }

    // ── Tenant school data — restricted to mapped school or super-admin ─────────
    match /tenant_data/{schoolId} {
      allow read:   if canAccessSchool(schoolId) || isSuperAdmin();
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin() ||
                       (isSchoolAdmin(schoolId) &&
                        noMigratedKeysResurrection() &&
                        notWipingRoster('students') &&
                        notWipingRoster('teachers') &&
                        notWipingLedger('fees') &&
                        notWipingLedger('attendance') &&
                        notWipingLedger('examMarks') &&
                        notOversizedBlobs()) ||
                       isTeacherAllowedRootUpdate(schoolId);
      allow delete: if false;
    }

    // ── Fees Years Subcollection — School Admin & Super Admin ONLY ───────────
    match /tenant_data/{schoolId}/fees_years/{allChildren=**} {
      allow read:  if isSchoolAdmin(schoolId) || isSuperAdmin();
      allow write: if (isSchoolAdmin(schoolId) || isSuperAdmin()) && validFeeMonthDoc();
    }

    // ── Fee Receipt Counters Subcollection — School Admin & Super Admin ONLY ──
    match /tenant_data/{schoolId}/counters/{counterId} {
      allow read, write: if isSchoolAdmin(schoolId) || isSuperAdmin();
    }

    // ── Attendance Months Subcollection — School Users (Admin / Teacher) ─────
    match /tenant_data/{schoolId}/attendance_months/{allChildren=**} {
      allow read, write: if canAccessSchool(schoolId) || isSuperAdmin();
    }

    // ── Exam Marks Subcollection — School Users (Admin / Teacher) ─────────────
    match /tenant_data/{schoolId}/exam_marks/{allChildren=**} {
      allow read, write: if canAccessSchool(schoolId) || isSuperAdmin();
    }

    // ── Core Students Subcollection — Admin write, Teacher read ───────────────
    match /tenant_data/{schoolId}/students/{studentId} {
      allow read:  if isSchoolAdmin(schoolId) || isSuperAdmin() || isSchoolTeacher(schoolId);
      allow write: if (isSchoolAdmin(schoolId) || isSuperAdmin())
                      && request.resource.data.schoolId == schoolId;
    }

    // ── Student & Teacher Profiles Subcollections ─────────────────────────────
    // Private student profiles — school admin + super admin only
    match /tenant_data/{schoolId}/student_profiles/{studentId} {
      allow read, write: if isSchoolAdmin(schoolId) || isSuperAdmin();
    }

    // Shared student profiles (visible to teachers) — readable by school users, writable only by admin
    match /tenant_data/{schoolId}/student_profiles_shared/{studentId} {
      allow read:  if canAccessSchool(schoolId) || isSuperAdmin();
      allow write: if isSchoolAdmin(schoolId) || isSuperAdmin();
    }

    // Teacher profiles — admin: read/write; own teacher: read-only; other teachers: denied
    match /tenant_data/{schoolId}/teacher_profiles/{teacherId} {
      allow read:  if isSchoolAdmin(schoolId) || isSuperAdmin() || isOwnTeacherProfile(schoolId, teacherId);
      allow write: if isSchoolAdmin(schoolId) || isSuperAdmin();
    }

    // Fee Activity Logs Subcollection — school admin & super admin only (teachers blocked)
    match /tenant_data/{schoolId}/fee_activity_logs/{logId} {
      allow read, write: if isSchoolAdmin(schoolId) || isSuperAdmin();
    }

    // Settings Subcollection — readable by school users, writable only by school admin
    match /tenant_data/{schoolId}/settings/{docId=**} {
      allow read:  if canAccessSchool(schoolId) || isSuperAdmin();
      allow write: if isSchoolAdmin(schoolId) || isSuperAdmin();
    }

    // ── Scaled Subcollections (storageVersion >= 2) ──────────────────────────
    // Teacher Attendance Punches (Monthly doc per teacher)
    match /tenant_data/{schoolId}/teacher_attendance/{month}/teachers/{teacherId} {
      allow read:  if canAccessSchool(schoolId) || isSuperAdmin();
      allow write: if isSchoolAdmin(schoolId) || isSuperAdmin() ||
                      (isSchoolTeacher(schoolId) && isOwnTeacherProfile(schoolId, teacherId));
    }

    // Attendance Requests & Regularizations
    match /tenant_data/{schoolId}/attendance_requests/{requestId} {
      allow read:  if canAccessSchool(schoolId) || isSuperAdmin();
      allow write: if isSchoolAdmin(schoolId) || isSuperAdmin() ||
                      (isSchoolTeacher(schoolId) && request.resource.data.get('teacherId', '') == getTeacherId(schoolId));
    }

    // Absence Intimations
    match /tenant_data/{schoolId}/absence_intimations/{intimationId} {
      allow read:  if canAccessSchool(schoolId) || isSuperAdmin();
      allow write: if canAccessSchool(schoolId) || isSuperAdmin();
    }

    // Notices / Announcements
    match /tenant_data/{schoolId}/notices/{noticeId} {
      allow read:  if canAccessSchool(schoolId) || isSuperAdmin();
      allow write: if isSchoolAdmin(schoolId) || isSuperAdmin();
    }

    // Notifications
    match /tenant_data/{schoolId}/notifications/{notifId} {
      allow read:  if canAccessSchool(schoolId) || isSuperAdmin();
      allow write: if isSchoolAdmin(schoolId) || isSuperAdmin();
    }

    // Exam Audit Log
    match /tenant_data/{schoolId}/exam_audit_log/{logId} {
      allow read:   if isSchoolAdmin(schoolId) || isSuperAdmin();
      allow create: if canAccessSchool(schoolId) || isSuperAdmin();
      allow update, delete: if isSchoolAdmin(schoolId) || isSuperAdmin();
    }

    // Trash / Recycle Bin
    match /tenant_data/{schoolId}/trash/{trashId} {
      allow read, write: if isSchoolAdmin(schoolId) || isSuperAdmin();
    }

    // Migration Reports
    match /tenant_data/{schoolId}/migration_reports/{reportId} {
      allow read:  if isSchoolAdmin(schoolId) || isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // Platform Health Monitor
    match /platform_health/{schoolId} {
      allow read, write: if isSuperAdmin();
    }

    // ── Accounts and Payroll Subcollections — School Admin ONLY (Super Admin BLOCKED) ──

    function isDefaultChartCode(code) {
      return code in [
        '11100', '11110', '11200', '11210', '12100', '13100', '13200',
        '21100', '22100', '22110', '22200', '22300', '22400', '22410', '23100', '24100',
        '31100', '32100',
        '41100', '41200', '41300', '41400', '42100', '43100', '43200',
        '51100', '51200', '51300', '51400', '51500', '52100', '52200', '53100', '53200', '53300', '54100', '54200', '55100'
      ];
    }

    function isReservedCategoryAccount(cat) {
      return cat in [
        '51100', '51200', '51300', '51400', '55100',
        '41100', '41200', '41300', '41400', '42100', '43100', '43200'
      ];
    }

    function isAllowedReceiptCategory(cat) {
      return (cat in ['43100', '43200']) ||
             (cat.matches('4[0-9]{4}') && !(cat in ['41100', '41200', '41300', '41400', '42100']));
    }

    function validReceiptCreate() {
      let d = request.resource.data;
      return d.keys().hasOnly([
               'receiptNo', 'date', 'financialYear', 'payerName', 'payerPhone',
               'categoryAccountId', 'amountPaise', 'paymentMode', 'receivedInAccountId',
               'referenceNo', 'description', 'attachments', 'status', 'createdBy', 'createdAt'
             ]) &&
             d.keys().hasAll([
               'receiptNo', 'date', 'financialYear', 'payerName',
               'categoryAccountId', 'amountPaise', 'paymentMode', 'receivedInAccountId',
               'attachments', 'status', 'createdBy', 'createdAt'
             ]) &&
             d.receiptNo is string && d.receiptNo.size() == 16 && d.receiptNo.matches('RCP-[0-9]{4}-[0-9]{2}-[0-9]{4}') &&
             d.date is string && d.date.size() == 10 && d.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}') &&
             d.financialYear is string && d.financialYear.size() == 7 && d.financialYear.matches('[0-9]{4}-[0-9]{2}') &&
             d.payerName is string && d.payerName.size() >= 1 && d.payerName.size() <= 120 &&
             d.categoryAccountId is string && isAllowedReceiptCategory(d.categoryAccountId) &&
             d.amountPaise is int && d.amountPaise > 0 && d.amountPaise <= 1000000000 &&
             d.paymentMode in ['Cash', 'UPI', 'Bank Transfer', 'Cheque'] &&
             d.receivedInAccountId is string && d.receivedInAccountId.size() > 0 &&
             d.attachments is list && d.attachments.size() <= 3 &&
             d.status == 'active' &&
             d.createdBy is string &&
             d.createdAt is string;
    }

    function validReceiptCancel() {
      let d = request.resource.data;
      return resource.data.get('status', 'active') == 'active' &&
             d.get('status', '') == 'cancelled' &&
             d.diff(resource.data).affectedKeys().hasOnly([
               'status', 'cancelReason', 'cancelledAt', 'cancelledBy'
             ]) &&
             d.cancelReason is string &&
             d.cancelReason.size() >= 1 &&
             d.cancelReason.size() <= 300 &&
             d.cancelReason.matches('.*[^ ].*');
    }

    function isCashOrBankAccountId(acc) {
      return acc.matches('111[0-9]{2}') || acc.matches('112[0-9]{2}');
    }

    function validTransferCreate() {
      let d = request.resource.data;
      return d.keys().hasOnly([
               'transferNo', 'date', 'financialYear', 'fromAccountId', 'toAccountId',
               'amountPaise', 'paymentMode', 'referenceNo', 'description',
               'status', 'createdBy', 'createdAt'
             ]) &&
             d.keys().hasAll([
               'transferNo', 'date', 'financialYear', 'fromAccountId', 'toAccountId',
               'amountPaise', 'status', 'createdBy', 'createdAt'
             ]) &&
             d.transferNo is string && d.transferNo.size() == 16 && d.transferNo.matches('TRF-[0-9]{4}-[0-9]{2}-[0-9]{4}') &&
             d.date is string && d.date.size() == 10 && d.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}') &&
             d.financialYear is string && d.financialYear.size() == 7 && d.financialYear.matches('[0-9]{4}-[0-9]{2}') &&
             d.fromAccountId is string && isCashOrBankAccountId(d.fromAccountId) &&
             d.toAccountId is string && isCashOrBankAccountId(d.toAccountId) &&
             d.fromAccountId != d.toAccountId &&
             d.amountPaise is int && d.amountPaise > 0 && d.amountPaise <= 1000000000 &&
             d.status == 'active' &&
             d.createdBy is string &&
             d.createdAt is string;
    }

    function validTransferCancel() {
      let d = request.resource.data;
      return resource.data.get('status', 'active') == 'active' &&
             d.get('status', '') == 'cancelled' &&
             d.diff(resource.data).affectedKeys().hasOnly([
               'status', 'cancelReason', 'cancelledAt', 'cancelledBy'
             ]) &&
             d.cancelReason is string &&
             d.cancelReason.size() >= 1 &&
             d.cancelReason.size() <= 300 &&
             d.cancelReason.matches('.*[^ ].*');
    }

    function validOpeningCreate() {
      let d = request.resource.data;
      return d.get('status', 'draft') in ['draft', 'locked'] &&
             d.get('lines', []) is list;
    }

    function validOpeningUpdate() {
      let d = request.resource.data;
      let currStatus = resource.data.get('status', 'draft');
      return currStatus == 'draft' &&
             d.get('status', '') in ['draft', 'locked'];
    }

    function validMainSettingsCreate() {
      let d = request.resource.data;
      return d.get('hasFeeVouchers', false) == false &&
             d.get('hasDigitalFeeVouchers', false) == false;
    }

    function validMainSettingsUpdate() {
      let req = request.resource.data;
      let res = resource.data;
      let hasVch = res.get('hasFeeVouchers', false) == true;
      let hasDigVch = res.get('hasDigitalFeeVouchers', false) == true;
      let resGoLive = res.get('goLiveDate', '');
      let resCash = res.get('feeCashAccount', '');
      let resDigital = res.get('feeDigitalAccount', '');

      // Server-only flags: client cannot change hasFeeVouchers or hasDigitalFeeVouchers
      let flagsUnchanged = req.get('hasFeeVouchers', false) == res.get('hasFeeVouchers', false) &&
                           req.get('hasDigitalFeeVouchers', false) == res.get('hasDigitalFeeVouchers', false);

      // goLiveDate immutable once hasFeeVouchers is true AND non-empty
      let goLiveOk = (!hasVch || resGoLive == '') || (req.get('goLiveDate', '') == resGoLive);

      // feeCashAccount immutable once hasFeeVouchers is true AND non-empty
      let feeCashOk = (!hasVch || resCash == '') || (req.get('feeCashAccount', '') == resCash);

      // feeDigitalAccount immutable once hasDigitalFeeVouchers is true AND non-empty
      let feeDigitalOk = (!hasDigVch || resDigital == '') || (req.get('feeDigitalAccount', '') == resDigital);

      return flagsUnchanged && goLiveOk && feeCashOk && feeDigitalOk;
    }

    function validExpenseCreate() {
      let d = request.resource.data;
      return d.keys().hasOnly([
               'expenseNo', 'date', 'financialYear', 'vendorName', 'vendorPhone',
               'categoryAccountId', 'amountPaise', 'paymentMode', 'paidFromAccountId',
               'referenceNo', 'description', 'attachments', 'status', 'createdBy', 'createdAt'
             ]) &&
             d.keys().hasAll([
               'expenseNo', 'date', 'financialYear', 'vendorName',
               'categoryAccountId', 'amountPaise', 'paymentMode', 'paidFromAccountId',
               'attachments', 'status', 'createdBy', 'createdAt'
             ]) &&
             d.expenseNo is string && d.expenseNo.size() == 16 && d.expenseNo.matches('EXP-[0-9]{4}-[0-9]{2}-[0-9]{4}') &&
             d.date is string && d.date.size() == 10 && d.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}') &&
             d.financialYear is string && d.financialYear.size() == 7 && d.financialYear.matches('[0-9]{4}-[0-9]{2}') &&
             d.vendorName is string && d.vendorName.size() >= 1 && d.vendorName.size() <= 120 &&
             d.categoryAccountId is string && !isReservedCategoryAccount(d.categoryAccountId) &&
             d.amountPaise is int && d.amountPaise > 0 && d.amountPaise <= 1000000000 &&
             d.paymentMode in ['Cash', 'UPI', 'Bank Transfer', 'Cheque'] &&
             d.paidFromAccountId is string && d.paidFromAccountId.size() > 0 &&
             d.attachments is list && d.attachments.size() <= 3 &&
             d.status == 'active' &&
             d.createdBy is string &&
             d.createdAt is string;
    }

    function validExpenseCancel() {
      let d = request.resource.data;
      return resource.data.get('status', 'active') == 'active' &&
             d.get('status', '') == 'cancelled' &&
             d.diff(resource.data).affectedKeys().hasOnly([
               'status', 'cancelReason', 'cancelledAt', 'cancelledBy'
             ]) &&
             d.cancelReason is string &&
             d.cancelReason.size() >= 1 &&
             d.cancelReason.size() <= 300 &&
             d.cancelReason.matches('.*[^ ].*');
    }

    function validAdvanceCreate() {
      let d = request.resource.data;
      return d.keys().hasOnly([
               'advanceNo', 'date', 'financialYear', 'employeeId', 'employeeName',
               'employeeType', 'amountPaise', 'paymentMode', 'paidFromAccountId',
               'recoveryMonthlyPaise', 'referenceNo', 'description', 'status', 'createdBy', 'createdAt'
             ]) &&
             d.keys().hasAll([
               'date', 'financialYear', 'employeeId', 'employeeName',
               'employeeType', 'amountPaise', 'paidFromAccountId', 'status', 'createdBy', 'createdAt'
             ]) &&
             d.employeeType in ['teacher', 'staff'] &&
             d.date is string && d.date.size() == 10 && d.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}') &&
             d.financialYear is string && d.financialYear.size() == 7 && d.financialYear.matches('[0-9]{4}-[0-9]{2}') &&
             d.paidFromAccountId is string && isCashOrBankAccountId(d.paidFromAccountId) &&
             d.amountPaise is int && d.amountPaise > 0 && d.amountPaise <= 1000000000 &&
             (!('recoveryMonthlyPaise' in d) || (d.recoveryMonthlyPaise is int && d.recoveryMonthlyPaise >= 0)) &&
             d.status == 'active' &&
             d.createdBy is string &&
             d.createdAt is string;
    }

    function validAdvanceCancel() {
      let d = request.resource.data;
      return resource.data.get('status', 'active') == 'active' &&
             d.get('status', '') == 'cancelled' &&
             d.diff(resource.data).affectedKeys().hasOnly([
               'status', 'cancelReason', 'cancelledAt', 'cancelledBy'
             ]) &&
             d.cancelReason is string &&
             d.cancelReason.size() >= 1 &&
             d.cancelReason.size() <= 300 &&
             d.cancelReason.matches('.*[^ ].*');
    }

    function validStatutoryPaymentCreate() {
      let d = request.resource.data;
      return d.keys().hasOnly([
               'paymentNo', 'date', 'financialYear', 'liabilityAccount',
               'amountPaise', 'paymentMode', 'paidFromAccountId', 'period',
               'challanRef', 'referenceNo', 'description', 'status', 'createdBy', 'createdAt'
             ]) &&
             d.keys().hasAll([
               'date', 'financialYear', 'liabilityAccount',
               'amountPaise', 'paidFromAccountId', 'status', 'createdBy', 'createdAt'
             ]) &&
             d.liabilityAccount in ['22100', '22110', '22200', '22300', '22400'] &&
             d.date is string && d.date.size() == 10 && d.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}') &&
             d.financialYear is string && d.financialYear.size() == 7 && d.financialYear.matches('[0-9]{4}-[0-9]{2}') &&
             d.paidFromAccountId is string && isCashOrBankAccountId(d.paidFromAccountId) &&
             d.amountPaise is int && d.amountPaise > 0 && d.amountPaise <= 1000000000 &&
             d.status == 'active' &&
             d.createdBy is string &&
             d.createdAt is string;
    }

    function validStatutoryPaymentCancel() {
      let d = request.resource.data;
      return resource.data.get('status', 'active') == 'active' &&
             d.get('status', '') == 'cancelled' &&
             d.diff(resource.data).affectedKeys().hasOnly([
               'status', 'cancelReason', 'cancelledAt', 'cancelledBy'
             ]) &&
             d.cancelReason is string &&
             d.cancelReason.size() >= 1 &&
             d.cancelReason.size() <= 300 &&
             d.cancelReason.matches('.*[^ ].*');
    }


    function isNonDecreasingYear(year, reqSeq, resSeq) {
      return !(year in resSeq) || !(year in reqSeq) || (reqSeq[year] is int && reqSeq[year] >= resSeq[year]);
    }

    function validCountersUpdate() {
      let reqExp = request.resource.data.get('expenseSeq', {});
      let resExp = resource.data.get('expenseSeq', {});
      let reqRcp = request.resource.data.get('receiptSeq', {});
      let resRcp = resource.data.get('receiptSeq', {});
      let reqTrf = request.resource.data.get('transferSeq', {});
      let resTrf = resource.data.get('transferSeq', {});
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      return affected.hasOnly(['expenseSeq', 'receiptSeq', 'transferSeq']) &&
             reqExp.diff(resExp).removedKeys().size() == 0 &&
             reqRcp.diff(resRcp).removedKeys().size() == 0 &&
             reqTrf.diff(resTrf).removedKeys().size() == 0 &&
             isNonDecreasingYear('2024-25', reqExp, resExp) &&
             isNonDecreasingYear('2025-26', reqExp, resExp) &&
             isNonDecreasingYear('2026-27', reqExp, resExp) &&
             isNonDecreasingYear('2027-28', reqExp, resExp) &&
             isNonDecreasingYear('2028-29', reqExp, resExp) &&
             isNonDecreasingYear('2024-25', reqRcp, resRcp) &&
             isNonDecreasingYear('2025-26', reqRcp, resRcp) &&
             isNonDecreasingYear('2026-27', reqRcp, resRcp) &&
             isNonDecreasingYear('2027-28', reqRcp, resRcp) &&
             isNonDecreasingYear('2028-29', reqRcp, resRcp) &&
             isNonDecreasingYear('2024-25', reqTrf, resTrf) &&
             isNonDecreasingYear('2025-26', reqTrf, resTrf) &&
             isNonDecreasingYear('2026-27', reqTrf, resTrf) &&
             isNonDecreasingYear('2027-28', reqTrf, resTrf) &&
             isNonDecreasingYear('2028-29', reqTrf, resTrf);
    }

    // 1. Accounts Settings: School Admin read/write; no deletes; counters cannot decrease; opening draft/lock rules
    match /tenant_data/{schoolId}/accounts_settings/{docId} {
      allow read:  if isSchoolAdmin(schoolId);
      allow create: if isSchoolAdmin(schoolId) &&
                       (docId == 'main' ? validMainSettingsCreate() :
                        docId == 'opening' ? validOpeningCreate() :
                        true);
      allow update: if isSchoolAdmin(schoolId) &&
                       (docId == 'counters' ? validCountersUpdate() :
                        docId == 'opening' ? validOpeningUpdate() :
                        docId == 'main' ? validMainSettingsUpdate() :
                        true);
      allow delete: if false;
    }

    // 2. Chart of Accounts: School Admin read/write; no deletes; system accounts immutable
    match /tenant_data/{schoolId}/accounts_chart/{code} {
      allow read:  if isSchoolAdmin(schoolId);
      allow create: if isSchoolAdmin(schoolId) &&
                       request.resource.data.get('code', '') == code &&
                       request.resource.data.get('type', '') in ['asset', 'liability', 'equity', 'income', 'expense'] &&
                       (request.resource.data.get('isSystem', false) == false || isDefaultChartCode(code));
      allow update: if isSchoolAdmin(schoolId) &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'isActive', 'updatedAt']) &&
                       (resource.data.get('isSystem', false) != true ||
                        (request.resource.data.get('isActive', true) == true &&
                         request.resource.data.get('name', '') == resource.data.get('name', '')));
      allow delete: if false;
    }

    // 3. Accounts Expenses: School Admin create with schema check; cancel-only update; no deletes
    match /tenant_data/{schoolId}/accounts_expenses/{expenseId} {
      allow read:   if isSchoolAdmin(schoolId);
      allow create: if isSchoolAdmin(schoolId) && validExpenseCreate();
      allow update: if isSchoolAdmin(schoolId) && validExpenseCancel();
      allow delete: if false;
    }

    // 3b. Accounts Receipts (Other Income): School Admin create with schema check; cancel-only update; no deletes
    match /tenant_data/{schoolId}/accounts_receipts/{receiptId} {
      allow read:   if isSchoolAdmin(schoolId);
      allow create: if isSchoolAdmin(schoolId) && validReceiptCreate();
      allow update: if isSchoolAdmin(schoolId) && validReceiptCancel();
      allow delete: if false;
    }

    // 3c. Accounts Transfers (Contra): School Admin create with schema check; cancel-only update; no deletes
    match /tenant_data/{schoolId}/accounts_transfers/{transferId} {
      allow read:   if isSchoolAdmin(schoolId);
      allow create: if isSchoolAdmin(schoolId) && validTransferCreate();
      allow update: if isSchoolAdmin(schoolId) && validTransferCancel();
      allow delete: if false;
    }

    // 3d. Accounts Journal: Server-derived ONLY. School Admin read; client write is FALSE
    match /tenant_data/{schoolId}/accounts_journal/{voucherId} {
      allow read:  if isSchoolAdmin(schoolId);
      allow write: if false;
    }

    // 3e. Accounts Summary: Server-derived ONLY. School Admin read; client write is FALSE
    match /tenant_data/{schoolId}/accounts_summary/{fy} {
      allow read:  if isSchoolAdmin(schoolId);
      allow write: if false;
    }

    // 3f. Accounts Sync State: Server-derived ONLY. School Admin read; client write is FALSE
    match /tenant_data/{schoolId}/accounts_sync_state/{fy} {
      allow read:  if isSchoolAdmin(schoolId);
      allow write: if false;
    }

    // 3g. Accounts Advances: School Admin create with schema check; cancel-only update; no deletes
    match /tenant_data/{schoolId}/accounts_advances/{advanceId} {
      allow read:   if isSchoolAdmin(schoolId);
      allow create: if isSchoolAdmin(schoolId) && validAdvanceCreate();
      allow update: if isSchoolAdmin(schoolId) && validAdvanceCancel();
      allow delete: if false;
    }

    // 3h. Accounts Statutory Payments: School Admin create with schema check; cancel-only update; no deletes
    match /tenant_data/{schoolId}/accounts_statutory_payments/{statId} {
      allow read:   if isSchoolAdmin(schoolId);
      allow create: if isSchoolAdmin(schoolId) && validStatutoryPaymentCreate();
      allow update: if isSchoolAdmin(schoolId) && validStatutoryPaymentCancel();
      allow delete: if false;
    }

    // 4. Staff Registry: School Admin read/write (no delete)
    match /tenant_data/{schoolId}/staff/{staffId} {
      allow read:   if isSchoolAdmin(schoolId);
      allow create, update: if isSchoolAdmin(schoolId);
      allow delete: if false;
    }

    // 5. Payroll Profiles: School Admin read/write (no delete)
    match /tenant_data/{schoolId}/payroll_profiles/{employeeId} {
      allow read:   if isSchoolAdmin(schoolId);
      allow create, update: if isSchoolAdmin(schoolId);
      allow delete: if false;
    }

    // 6. Payroll Settings: School Admin read/write (no delete)
    match /tenant_data/{schoolId}/payroll_settings/{docId} {
      allow read:   if isSchoolAdmin(schoolId);
      allow create, update: if isSchoolAdmin(schoolId);
      allow delete: if false;
    }

    // 7. Payroll Inputs: School Admin write only while run missing or status == 'draft' (no delete)
    match /tenant_data/{schoolId}/payroll_inputs/{month} {
      allow read:   if isSchoolAdmin(schoolId);
      allow create, update: if isSchoolAdmin(schoolId) &&
                               (!exists(/databases/$(database)/documents/tenant_data/$(schoolId)/payroll_runs/$(month)) ||
                                get(/databases/$(database)/documents/tenant_data/$(schoolId)/payroll_runs/$(month)).data.status == 'draft');
      allow delete: if false;
    }

    // 8. Payroll Runs (+ lines): Server-written ONLY
    match /tenant_data/{schoolId}/payroll_runs/{month} {
      allow read:  if isSchoolAdmin(schoolId);
      allow write: if false;
    }
    match /tenant_data/{schoolId}/payroll_runs/{month}/lines/{employeeId} {
      allow read:  if isSchoolAdmin(schoolId);
      allow write: if false;
    }

    // 9. Payslips: Server-written ONLY; Read: Admin, or owning teacher ONLY when status == 'paid'
    match /tenant_data/{schoolId}/payroll_payslips/{payslipId} {
      allow read:  if isSchoolAdmin(schoolId) ||
                      (isSchoolTeacher(schoolId) &&
                       resource.data.get('status', '') == 'paid' &&
                       resource.data.get('teacherId', '') == getTeacherId(schoolId));
      allow write: if false;
    }

    // 10. Other accounts/payroll collections (fallback - Super Admin BLOCKED)
    match /tenant_data/{schoolId}/{restrictedSubcol}/{allChildren=**} {
      allow read, write: if (
                            (restrictedSubcol.matches('accounts_.*') &&
                             restrictedSubcol != 'accounts_settings' &&
                             restrictedSubcol != 'accounts_chart' &&
                             restrictedSubcol != 'accounts_expenses' &&
                             restrictedSubcol != 'accounts_receipts' &&
                             restrictedSubcol != 'accounts_transfers' &&
                             restrictedSubcol != 'accounts_advances' &&
                             restrictedSubcol != 'accounts_statutory_payments' &&
                             restrictedSubcol != 'accounts_journal' &&
                             restrictedSubcol != 'accounts_summary' &&
                             restrictedSubcol != 'accounts_sync_state') ||
                            (restrictedSubcol.matches('payroll_.*') &&
                             restrictedSubcol != 'payroll_payslips' &&
                             restrictedSubcol != 'payroll_runs' &&
                             restrictedSubcol != 'payroll_inputs' &&
                             restrictedSubcol != 'payroll_profiles' &&
                             restrictedSubcol != 'payroll_settings'))
                         && isSchoolAdmin(schoolId);
    }

    // Private subcollection — Admin SDK only (completely blocked for all client roles)
    match /tenant_data/{schoolId}/private/{allChildren=**} {
      allow read, write: if false;
    }

    // Subcollections — default fallback: readable by school users, writable only by school admin
    match /tenant_data/{schoolId}/{subcollection}/{allChildren=**} {
      allow read:  if subcollection != 'student_profiles'
                      && subcollection != 'student_profiles_shared'
                      && subcollection != 'teacher_profiles'
                      && subcollection != 'students'
                      && subcollection != 'private'
                      && subcollection != 'fee_activity_logs'
                      && subcollection != 'fees_years'
                      && subcollection != 'counters'
                      && subcollection != 'settings'
                      && subcollection != 'attendance_months'
                      && subcollection != 'exam_marks'
                      && subcollection != 'payroll_payslips'
                      && subcollection != 'staff'
                      && subcollection != 'teacher_attendance'
                      && subcollection != 'attendance_requests'
                      && subcollection != 'absence_intimations'
                      && subcollection != 'notices'
                      && subcollection != 'notifications'
                      && subcollection != 'exam_audit_log'
                      && subcollection != 'trash'
                      && subcollection != 'migration_reports'
                      && !subcollection.matches('accounts_.*')
                      && !subcollection.matches('payroll_.*')
                      && (canAccessSchool(schoolId) || isSuperAdmin());
      allow write: if subcollection != 'student_profiles'
                      && subcollection != 'student_profiles_shared'
                      && subcollection != 'teacher_profiles'
                      && subcollection != 'students'
                      && subcollection != 'private'
                      && subcollection != 'fee_activity_logs'
                      && subcollection != 'fees_years'
                      && subcollection != 'counters'
                      && subcollection != 'settings'
                      && subcollection != 'attendance_months'
                      && subcollection != 'exam_marks'
                      && subcollection != 'payroll_payslips'
                      && subcollection != 'staff'
                      && subcollection != 'teacher_attendance'
                      && subcollection != 'attendance_requests'
                      && subcollection != 'absence_intimations'
                      && subcollection != 'notices'
                      && subcollection != 'notifications'
                      && subcollection != 'exam_audit_log'
                      && subcollection != 'trash'
                      && subcollection != 'migration_reports'
                      && !subcollection.matches('accounts_.*')
                      && !subcollection.matches('payroll_.*')
                      && (isSchoolAdmin(schoolId) || isSuperAdmin());
    }

    // ── School registry — public read; write = super-admin or school admin branding sync ──
    match /schools/{schoolId} {
      allow read:   if true;
      allow create: if isSuperAdmin();
      allow delete: if isSuperAdmin();
      allow update: if isSuperAdmin() ||
                       (isSchoolAdmin(schoolId) &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['logo_url', 'school_name', 'tagline']) &&
                        request.resource.data.get('logo_url', '').size() < 800000);
    }

    // ── F8: Super-admin data — restricted to super-admin Firebase UID only ───
    match /sa_data/{docId} {
      allow read, write: if isSuperAdmin();
    }

    // ── Demo requests — public create with basic validation; super-admin management ──
    match /demo_requests/{docId} {
      allow create:              if request.resource.data.get('phone', '') is string
                                    && request.resource.data.get('phone', '').size() >= 10;
      allow read, update, delete: if isSuperAdmin();
    }

    // ── Login rate limits — Admin SDK only ──────────────────────────────────
    match /login_rate_limits/{docId} {
      allow read, write: if false;
    }

    // ── Class rename backups — super-admin only ─────────────────────────────
    match /rename_backups/{docId} {
      allow read, write: if isSuperAdmin();
    }

    // ── Self-Service Onboarding & Referral Collections ──────────────────────
    match /registrations/{regId} {
      allow read, write: if false;
    }

    match /subdomain_reservations/{subdomain} {
      allow read, write: if false;
    }

    match /registration_rate_limits/{docId} {
      allow read, write: if false;
    }

    match /referral_codes/{codeId} {
      allow read, write: if isSuperAdmin();
    }

  }
}
