{
  "version": 2,
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/version.json",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ],
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1",
      "continue": false
    },
    {
      "src": "/super-admin\\.html",
      "dest": "/super-admin.html",
      "continue": false
    },
    {
      "src": "/super-admin",
      "dest": "/super-admin.html",
      "continue": false
    },
    {
      "src": "/landing\\.html",
      "dest": "/landing.html",
      "continue": false
    },
    {
      "src": "/landing",
      "dest": "/landing.html",
      "continue": false
    },
    {
      "src": "/register\\.html",
      "dest": "/register.html",
      "continue": false
    },
    {
      "src": "/register",
      "dest": "/register.html",
      "continue": false
    },
    {
      "src": "/privacy\\.html",
      "dest": "/privacy.html",
      "continue": false
    },
    {
      "src": "/privacy",
      "dest": "/privacy.html",
      "continue": false
    },
    {
      "src": "/terms\\.html",
      "dest": "/terms.html",
      "continue": false
    },
    {
      "src": "/terms",
      "dest": "/terms.html",
      "continue": false
    },
    {
      "src": "/",
      "has": [
        {
          "type": "host",
          "value": "^(?:www\\.)?ctrlshifts\\.in$"
        }
      ],
      "dest": "/landing.html",
      "continue": false
    },
    {
      "src": "/(?:scratch|scripts|ANTIGRAVITY-TASKS|Claude outputs|shishu-vikash|backups|brain|node_modules)(?:/.*)?$",
      "status": 404
    },
    {
      "src": "/(?:service-account-key\\.json|.*firebase-adminsdk.*\\.json|\\.env.*|firestore\\.rules|firebase\\.json|\\.firebaserc|server\\.js|validate\\.js|netlify\\.toml|firestore-debug\\.log|.*\\.md)$",
      "status": 404
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
