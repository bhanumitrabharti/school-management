{
  "version": 2,
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/version.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "/api/registration-start(?:\\?.*)?",
      "dest": "/api/registration.js?action=start",
      "continue": false
    },
    {
      "src": "/api/registration-verify-otp(?:\\?.*)?",
      "dest": "/api/registration.js?action=verify-otp",
      "continue": false
    },
    {
      "src": "/api/subdomain-check(?:\\?.*)?",
      "dest": "/api/registration.js?action=subdomain",
      "continue": false
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1",
      "continue": false
    },
    {
      "src": "/super-admin\\.html",
      "dest": "/super-admin.html",
      "continue": false
    },
    {
      "src": "/super-admin",
      "dest": "/super-admin.html",
      "continue": false
    },
    {
      "src": "/landing\\.html",
      "dest": "/landing.html",
      "continue": false
    },
    {
      "src": "/landing",
      "dest": "/landing.html",
      "continue": false
    },
    {
      "src": "/parents\\.html",
      "dest": "/parents.html",
      "continue": false
    },
    {
      "src": "/parents",
      "dest": "/parents.html",
      "continue": false
    },
    {
      "src": "/register\\.html",
      "dest": "/register.html",
      "continue": false
    },
    {
      "src": "/register",
      "dest": "/register.html",
      "continue": false
    },
    {
      "src": "/privacy\\.html",
      "dest": "/privacy.html",
      "continue": false
    },
    {
      "src": "/privacy",
      "dest": "/privacy.html",
      "continue": false
    },
    {
      "src": "/terms\\.html",
      "dest": "/terms.html",
      "continue": false
    },
    {
      "src": "/terms",
      "dest": "/terms.html",
      "continue": false
    },
    {
      "src": "/about\\.html",
      "dest": "/about.html",
      "continue": false
    },
    {
      "src": "/about",
      "dest": "/about.html",
      "continue": false
    },
    {
      "src": "/case-study\\.html",
      "dest": "/case-study.html",
      "continue": false
    },
    {
      "src": "/case-study",
      "dest": "/case-study.html",
      "continue": false
    },
    {
      "src": "/404\\.html",
      "dest": "/404.html",
      "continue": false
    },
    {
      "src": "/404",
      "dest": "/404.html",
      "continue": false
    },
    {
      "src": "/",
      "has": [
        {
          "type": "host",
          "value": "^parents\\.ctrlshifts\\.in$"
        }
      ],
      "dest": "/parents.html",
      "continue": false
    },
    {
      "src": "/",
      "has": [
        {
          "type": "host",
          "value": "^(?:www\\.)?ctrlshifts\\.in$"
        }
      ],
      "dest": "/landing.html",
      "continue": false
    },
    {
      "src": "/(?:scratch|scripts|ANTIGRAVITY-TASKS|Claude outputs|shishu-vikash|backups|brain|node_modules)(?:/.*)?$",
      "status": 404
    },
    {
      "src": "/(?:service-account-key\\.json|.*firebase-adminsdk.*\\.json|\\.env.*|firestore\\.rules|firebase\\.json|\\.firebaserc|server\\.js|validate\\.js|netlify\\.toml|firestore-debug\\.log|.*\\.md)$",
      "status": 404
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "^(?!www\\.)[a-z0-9-]+\\.ctrlshifts\\.in$"
        }
      ],
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      },
      "continue": true
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "^parents\\.ctrlshifts\\.in$"
        }
      ],
      "dest": "/parents.html"
    },
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "^(?:www\\.)?ctrlshifts\\.in$"
        }
      ],
      "dest": "/404.html",
      "status": 404
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
